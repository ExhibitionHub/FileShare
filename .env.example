PORT=3101
NODE_ENV=development
HOST_PORT=3101

# Activer le profil tls sur le VPS : COMPOSE_PROFILES=tls.
COMPOSE_PROFILES=
TLS_PORT=8445
TLS_CERT_ROOT=./deploy/certs

# filesystem pour une seule instance, s3 pour plusieurs instances/régions.
STORAGE_DRIVER=filesystem
DATA_DIR=./data

# Configuration S3 compatible (AWS S3, Cloudflare R2, MinIO...).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=fileshare/

# URL HTTPS publique du service en production, sans slash final.
# Vide en local : l'API la déduit de la requête.
PUBLIC_BASE_URL=

# URL publique du Dino Passport. Les QR de créations ouvriront cette PWA.
PASSPORT_BASE_URL=http://localhost:4174/

# Origines séparées par des virgules, ou * pour toutes les autoriser.
CORS_ORIGINS=*

# Facultatif en développement. En production, définir une valeur longue et aléatoire.
UPLOAD_API_KEY=
# Plusieurs clés peuvent être séparées par des virgules pour les proxies de différents sites.
UPLOAD_API_KEYS=
# true autorise les bornes navigateur à uploader sans secret. DELETE exige toujours une clé.
# Préférer false avec un proxy et une clé propre par site lorsque c'est possible.
ALLOW_PUBLIC_UPLOADS=true

# Le Passport refuse les images de plus de 5 Mo.
MAX_IMAGE_BYTES=5242880

# Nettoyage automatique : 7 jours par défaut, 30 jours maximum par upload.
DEFAULT_TTL_HOURS=168
MAX_TTL_HOURS=720
ALLOW_PERMANENT_FILES=false
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_MINUTES=15
CLEANUP_BATCH_SIZE=500

# Protection contre la surcharge. Les limites HTTP sont appliquées par instance.
RATE_LIMIT_WINDOW_MS=60000
READ_RATE_LIMIT=3000
UPLOAD_RATE_LIMIT=300
MAX_CONCURRENT_UPLOADS=20
MAX_QUEUED_UPLOADS=100
UPLOAD_QUEUE_TIMEOUT_MS=5000

# Nombre de reverse proxies de confiance devant Node. 0 en accès direct.
TRUST_PROXY_HOPS=1
REQUEST_TIMEOUT_MS=20000
